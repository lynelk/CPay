server {
    # Railway private networking is IPv6-first. Bind explicitly on both stacks
    # so health checks and public proxy traffic can reach nginx reliably.
    listen ${PORT} default_server;
    listen [::]:${PORT} default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    # Canonical public API gateway. The public /api prefix is intentionally
    # stripped because the Spring application exposes controllers at paths such
    # as /auth, /merchants and /settings. The backend itself stays private on
    # Railway's service network.
    location = /api {
        return 308 /api/;
    }

    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://${BACKEND_UPSTREAM}/;
    }

    # Temporary compatibility for older clients/bookmarks that called backend
    # controller families directly on the UI origin. New browser traffic uses
    # /api exclusively and these aliases can be retired after the cutover.
    location ~ ^/(auth|admins|merchants|settings|audittrail|transactions|actuator|status|v3|swagger-ui)(/|$) {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://${BACKEND_UPSTREAM};
    }

    # Fingerprinted Vite assets can be cached aggressively.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # React Router history fallback. /bo and its deep links are therefore
    # served by the same SPA without needing a second public service.
    location / {
        try_files $uri $uri/ /index.html;
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
