{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "mvn -B -DskipTests clean package --no-transfer-progress"
  },
  "deploy": {
    "startCommand": "sh -c 'exec java -Dserver.port=${HTTP_PORT:-${PORT:-8080}} -jar /app/cpay-backend.jar'",
    "healthcheckPath": "/status/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
