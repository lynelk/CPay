{
  "info": {
    "name": "CPay v2 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://cpaytest.coresynergi.es:8443" },
    { "key": "merchantNumber", "value": "1000000" },
    { "key": "checkoutToken", "value": "replace-with-created-payment-link-token" },
    { "key": "adminUser", "value": "replace-with-admin-email" },
    { "key": "adminPassword", "value": "replace-with-admin-password" }
  ],
  "item": [
    {
      "name": "Native Collect",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-CPay-Signature-Version", "value": "v2" },
          { "key": "X-CPay-Timestamp", "value": "{{timestamp}}" },
          { "key": "X-CPay-Nonce", "value": "{{nonce}}" },
          { "key": "X-CPay-Signature", "value": "{{signature}}" },
          { "key": "X-CPay-Idempotency-Key", "value": "{{idempotencyKey}}" }
        ],
        "url": "{{baseUrl}}/api/v2/native/payments/collect",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantNumber\": \"{{merchantNumber}}\",\n  \"channel\": \"mtn_momo\",\n  \"country\": \"UG\",\n  \"currency\": \"UGX\",\n  \"amount\": \"5000.00\",\n  \"reference\": \"ORD-10001\",\n  \"description\": \"Order payment\",\n  \"callbackUrl\": \"https://merchant.example/cpay/callback\",\n  \"payer\": {\"type\": \"MSISDN\", \"value\": \"256770000000\"}\n}"
        }
      }
    },
    {
      "name": "Native Payout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-CPay-Signature-Version", "value": "v2" },
          { "key": "X-CPay-Timestamp", "value": "{{timestamp}}" },
          { "key": "X-CPay-Nonce", "value": "{{nonce}}" },
          { "key": "X-CPay-Signature", "value": "{{signature}}" },
          { "key": "X-CPay-Idempotency-Key", "value": "{{idempotencyKey}}" }
        ],
        "url": "{{baseUrl}}/api/v2/native/payments/payout",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantNumber\": \"{{merchantNumber}}\",\n  \"channel\": \"airtel_money\",\n  \"country\": \"UG\",\n  \"currency\": \"UGX\",\n  \"amount\": \"5000.00\",\n  \"reference\": \"PAYOUT-10001\",\n  \"description\": \"Customer payout\",\n  \"callbackUrl\": \"https://merchant.example/cpay/callback\",\n  \"payee\": {\"type\": \"MSISDN\", \"value\": \"256750000000\"}\n}"
        }
      }
    },
    {
      "name": "Validate Account",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-CPay-Signature-Version", "value": "v2" },
          { "key": "X-CPay-Timestamp", "value": "{{timestamp}}" },
          { "key": "X-CPay-Nonce", "value": "{{nonce}}" },
          { "key": "X-CPay-Signature", "value": "{{signature}}" }
        ],
        "url": "{{baseUrl}}/api/v2/accounts/validate",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantNumber\": \"{{merchantNumber}}\",\n  \"msisdn\": \"256770000000\"\n}"
        }
      }
    },
    {
      "name": "Statement Export CSV",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-CPay-Signature-Version", "value": "v2" },
          { "key": "X-CPay-Timestamp", "value": "{{timestamp}}" },
          { "key": "X-CPay-Nonce", "value": "{{nonce}}" },
          { "key": "X-CPay-Signature", "value": "{{signature}}" }
        ],
        "url": "{{baseUrl}}/api/v2/statements?merchantNumber={{merchantNumber}}&startDate=2026-07-01&endDate=2026-07-16&format=csv&limit=1000"
      }
    },
    {
      "name": "Create Payment Link",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-CPay-Signature-Version", "value": "v2" },
          { "key": "X-CPay-Timestamp", "value": "{{timestamp}}" },
          { "key": "X-CPay-Nonce", "value": "{{nonce}}" },
          { "key": "X-CPay-Signature", "value": "{{signature}}" },
          { "key": "X-CPay-Idempotency-Key", "value": "{{idempotencyKey}}" }
        ],
        "url": "{{baseUrl}}/api/v2/payment-links",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantNumber\": \"{{merchantNumber}}\",\n  \"country\": \"UG\",\n  \"currency\": \"UGX\",\n  \"amount\": \"25000.00\",\n  \"reference\": \"PLINK-10001\",\n  \"description\": \"Hosted checkout invoice\",\n  \"callbackUrl\": \"https://merchant.example/cpay/callback\"\n}"
        }
      }
    },
    {
      "name": "Hosted Checkout Pay",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/v2/checkout/{{checkoutToken}}/pay",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"payerAccount\": \"256770000000\",\n  \"channel\": \"mtn_momo\"\n}"
        }
      }
    },
    {
      "name": "FX Quote",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-CPay-Signature-Version", "value": "v2" },
          { "key": "X-CPay-Timestamp", "value": "{{timestamp}}" },
          { "key": "X-CPay-Nonce", "value": "{{nonce}}" },
          { "key": "X-CPay-Signature", "value": "{{signature}}" }
        ],
        "url": "{{baseUrl}}/api/v2/fx/quotes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantNumber\": \"{{merchantNumber}}\",\n  \"sourceCurrency\": \"UGX\",\n  \"targetCurrency\": \"KES\",\n  \"sourceAmount\": \"100000.00\"\n}"
        }
      }
    },
    {
      "name": "Cross-Border Transfer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-CPay-Signature-Version", "value": "v2" },
          { "key": "X-CPay-Timestamp", "value": "{{timestamp}}" },
          { "key": "X-CPay-Nonce", "value": "{{nonce}}" },
          { "key": "X-CPay-Signature", "value": "{{signature}}" }
        ],
        "url": "{{baseUrl}}/api/v2/cross-border/transfers",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantNumber\": \"{{merchantNumber}}\",\n  \"quoteReference\": \"FXQ-10001\",\n  \"sourceCountry\": \"UG\",\n  \"targetCountry\": \"KE\",\n  \"sourceCurrency\": \"UGX\",\n  \"targetCurrency\": \"KES\",\n  \"sourceAmount\": \"100000.00\",\n  \"beneficiaryAccount\": \"254700000000\",\n  \"beneficiaryName\": \"Jane Doe\",\n  \"description\": \"Cross-border transfer\"\n}"
        }
      }
    },
    {
      "name": "Webhook Event Catalog",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v2/webhooks/events"
      }
    },
    {
      "name": "Reconciliation Import",
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{adminUser}}", "type": "string" },
            { "key": "password", "value": "{{adminPassword}}", "type": "string" }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/v2/admin/reconciliation/import?provider=MTN&importedBy=ops",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": "/path/to/provider-statement.csv" }
          ]
        }
      }
    },
    {
      "name": "Reconciliation Auto-Match",
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{adminUser}}", "type": "string" },
            { "key": "password", "value": "{{adminPassword}}", "type": "string" }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/v2/admin/reconciliation/auto-match"
      }
    },
    {
      "name": "Reconciliation Review Request",
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{adminUser}}", "type": "string" },
            { "key": "password", "value": "{{adminPassword}}", "type": "string" }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/v2/admin/reconciliation/reviews/request?recordId=42&type=ADJUSTMENT&amount=2500.00&currency=UGX&reason=Provider+statement+mismatch&requestedBy=ops"
      }
    },
    {
      "name": "Recon Finance Close",
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{adminUser}}", "type": "string" },
            { "key": "password", "value": "{{adminPassword}}", "type": "string" }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/v2/admin/recon-finance/close?date=2026-08-05&currency=UGX&submittedBy=ops"
      }
    },
    {
      "name": "Recon Finance Close Approve",
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{adminUser}}", "type": "string" },
            { "key": "password", "value": "{{adminPassword}}", "type": "string" }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/v2/admin/recon-finance/close/approve?date=2026-08-05&currency=UGX&approvedBy=finance"
      }
    },
    {
      "name": "Settlement Open",
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{adminUser}}", "type": "string" },
            { "key": "password", "value": "{{adminPassword}}", "type": "string" }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/v2/admin/reconciliation/settlements/open?reference=STL-20260805-001&provider=MTN&channel=mtn_momo&currency=UGX&expectedAmount=1250000.00&openedBy=ops"
      }
    },
    {
      "name": "Payout Approvals List",
      "request": {
        "method": "GET",
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{adminUser}}", "type": "string" },
            { "key": "password", "value": "{{adminPassword}}", "type": "string" }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/v2/admin/payout-approvals?limit=100"
      }
    },
    {
      "name": "Payout Approval Approve",
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{adminUser}}", "type": "string" },
            { "key": "password", "value": "{{adminPassword}}", "type": "string" }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/v2/admin/payout-approvals/1/approve?approvedBy=finance"
      }
    },
    {
      "name": "Webhook Register Endpoint",
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{adminUser}}", "type": "string" },
            { "key": "password", "value": "{{adminPassword}}", "type": "string" }
          ]
        },
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/v2/admin/webhooks/merchants/1",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventType\": \"payment.completed\",\n  \"endpointUrl\": \"https://merchant.example/cpay/callback\",\n  \"actor\": \"ops\"\n}"
        }
      }
    },
    {
      "name": "Webhook Test Callback",
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{adminUser}}", "type": "string" },
            { "key": "password", "value": "{{adminPassword}}", "type": "string" }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/v2/admin/webhooks/merchants/1/test-callback?eventType=payment.completed&actor=ops"
      }
    },
    {
      "name": "Regulator Daily Cash Flow",
      "request": {
        "method": "GET",
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{adminUser}}", "type": "string" },
            { "key": "password", "value": "{{adminPassword}}", "type": "string" }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/v2/admin/regulator/daily-cash-flow?reportDate=2026-08-05"
      }
    },
    {
      "name": "Reporting Transaction Stats",
      "request": {
        "method": "GET",
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{adminUser}}", "type": "string" },
            { "key": "password", "value": "{{adminPassword}}", "type": "string" }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/v2/admin/reporting/transaction-stats?from=2026-07-06&to=2026-08-05"
      }
    },
    {
      "name": "Treasury Positions",
      "request": {
        "method": "GET",
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{adminUser}}", "type": "string" },
            { "key": "password", "value": "{{adminPassword}}", "type": "string" }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/v2/admin/treasury/positions"
      }
    }
  ]
}
