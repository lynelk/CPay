# CPay Environment Variables
# Copy this file to .env and fill in the actual values.
# NEVER commit the .env file to version control.

# Database
DB_URL=jdbc:mysql://localhost:3306/cpayadmin
DB_USERNAME=
DB_PASSWORD=

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# HTTP port
HTTP_PORT=8081

# Lock file directory
CUSTOM_LOCKFILEDIRECTORY=/var/opt/cpay/locks/

# MTN MoMo API credentials (loaded from DB settings at runtime)
MTN_COLLECTIONS_USER=
MTN_COLLECTIONS_KEY=
MTN_COLLECTIONS_SUBSCRIPTION=
MTN_DISBURSEMENTS_USER=
MTN_DISBURSEMENTS_KEY=
MTN_DISBURSEMENTS_SUBSCRIPTION=

# Airtel Money OpenAPI credentials (loaded from DB settings at runtime)
AIRTEL_COLLECTIONS_USER=
AIRTEL_COLLECTIONS_KEY=
AIRTEL_DISBURSEMENTS_USER=
AIRTEL_DISBURSEMENTS_KEY=
AIRTEL_DISBURSEMENTS_SUBSCRIPTION=

# Safaricom Daraja API credentials (loaded from DB settings at runtime)
SAFARICOM_CONSUMER_KEY=
SAFARICOM_CONSUMER_SECRET=

# Gateway state: SANDBOX or PRODUCTION
CUSTOM_GATEWAYSTATE=SANDBOX
CUSTOM_SSL_SKIP_VERIFY=false

# CORS – comma-separated list of allowed origins for admin/merchant portals
CORS_ALLOWED_ORIGINS=https://yourdomain.com
# Trusted proxy IPs whose X-Forwarded-For/X-Real-IP headers may be honored.
# Leave blank when the app is not behind a trusted reverse proxy.
CPAY_TRUSTED_PROXY_IPS=

# Actuator monitoring credentials (REQUIRED – no defaults; app will not start without these)
ACTUATOR_USERNAME=
ACTUATOR_PASSWORD=

# API documentation endpoints (disabled by default for production safety)
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false

# v2 replay protection nonce store: memory for local, jdbc for clustered production
CPAY_SECURITY_NONCE_STORE=memory

# Admin API credentials (REQUIRED – separate from actuator credentials)
ADMIN_API_USERNAME=
ADMIN_API_PASSWORD=

# Signing/encryption secrets (REQUIRED – use long random values)
CALLBACK_SIGNING_SECRET=
MERCHANT_CHANNEL_ENCRYPTION_KEY=
# Dedicated 256-bit key (base64, 32 random bytes) for merchant RSA private keys at rest (E6).
# When unset, MERCHANT_CHANNEL_ENCRYPTION_KEY is used as a fallback for backward compatibility.
CPAY_KEY_ENCRYPTION_KEY=
CPAY_KEY_ENCRYPTION_HSM=false
CPAY_KEY_REENCRYPTION_ENABLED=true

# Operational cleanup, session cap, ledger repair, and EFRIS extension point
CPAY_CLEANUP_ENABLED=true
CPAY_API_RATE_LIMIT_RETENTION_MINUTES=1440
CPAY_CALLBACK_CLAIM_RETENTION_HOURS=24
CPAY_PASSWORD_RESET_TOKEN_RETENTION_DAYS=7
CPAY_WEBHOOK_DELIVERY_RETENTION_DAYS=30
CPAY_CALLBACK_TASK_RETENTION_DAYS=30
CPAY_CALLBACK_SIGNATURE_RETENTION_DAYS=30
CPAY_PROVIDER_RUN_RETENTION_DAYS=90
CPAY_SESSION_ABSOLUTE_MAX_HOURS=12
CPAY_LEDGER_REPAIR_LIMIT=100
CPAY_EFRIS_DELIVER_ENABLED=true
CPAY_EFRIS_DELIVER_FIXED_DELAY_MS=60000

# Application base URL used in password-reset emails (no trailing slash)
APP_BASE_URL=https://yourdomain.com

# Merchant integrations (e.g. CitoConnect).
# Each merchant is registered in the database with their own RSA public key.
# The values below are convenience defaults referenced by integration tooling.
# DEFAULT_MERCHANT_CALLBACK_URL is used by Integrations/Citoconnect/cpay-client.js
# when a per-call callback_url is not supplied.
CITOCONNECT_MERCHANT_NUMBER=
DEFAULT_MERCHANT_CALLBACK_URL=
